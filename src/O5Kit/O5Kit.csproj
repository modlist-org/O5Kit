<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Dual-target like Overlayer: netstandard2.0 = Mono, net6.0 = IL2CPP -->
    <TargetFramework Condition="$(Configuration.Contains('IL2CPP'))">net6.0</TargetFramework>
    <TargetFramework Condition="!$(Configuration.Contains('IL2CPP'))">netstandard2.0</TargetFramework>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <ImplicitUsings>disable</ImplicitUsings>
    <!-- NOTE: ImplicitUsings stays OFF: global `using System;` makes LitMotion's
         Unity.Mathematics.Random ambiguous with System.Random (CS0104). -->
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>O5Kit</RootNamespace>
    <!-- Side-by-side by VERSION (major.minor; patch excluded, patches are
         drop-in): every mod built against the same O5Kit generation shares one
         loaded copy (same simple name = same identity on UMM / MelonLoader /
         BepInEx), so runtime copies scale with versions, not with mod count.
         The name derives from <Version> automatically: bump major/minor and
         the name follows (1.0 -> O5Kit.1.0, 1.1 -> O5Kit.1.1, 2.0 -> ...).
         Escape hatch for special cases:
           dotnet build -p:O5KitAssemblyName=MyMod.O5Kit -->
    <Version>1.0.0</Version>
    <O5KitVersionPrefix>$([System.Version]::Parse('$(Version)').ToString(2))</O5KitVersionPrefix>
    <AssemblyName Condition="'$(O5KitAssemblyName)' == ''">O5Kit.$(O5KitVersionPrefix)</AssemblyName>
    <AssemblyName Condition="'$(O5KitAssemblyName)' != ''">$(O5KitAssemblyName)</AssemblyName>
    <Authors>modlist-org</Authors>
    <Description>O5 UI toolkit for Unity mods: pretty uGUI controls + input (UniverseLib-style). LGPL-3.0-or-later.</Description>
    <PackageLicenseExpression>LGPL-3.0-or-later</PackageLicenseExpression>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
    <IsPackable>true</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <Configurations>Debug_Mono;Release_Mono;Debug_IL2CPP;Release_IL2CPP</Configurations>
  </PropertyGroup>

  <ItemDefinitionGroup>
    <!-- Game/loader assemblies are compile-only (mirrors Overlayer convention). -->
    <Reference>
      <Private>false</Private>
    </Reference>
  </ItemDefinitionGroup>

  <PropertyGroup Condition="$(Configuration.Contains('IL2CPP'))">
    <DefineConstants>$(DefineConstants);IL2CPP</DefineConstants><!-- IL2CPP: LITMOTION stays undefined by default (Burst/Collections are often stripped; AutoTweenRunner falls back to GTween/reflection backends) -->
    <_Il2CppLoaderPath Condition="'$(Il2CppPath)' != ''">$(Il2CppPath)</_Il2CppLoaderPath>
    <_Il2CppLoaderPath Condition="'$(_Il2CppLoaderPath)' == ''">$(GamePath)</_Il2CppLoaderPath>
  </PropertyGroup>

  <!--
    Unity assemblies come from the game install (same pattern as Overlayer).
    Only the small surface used by O5Kit is referenced here; extend as controls are ported.
  -->
  <PropertyGroup Condition="!$(Configuration.Contains('IL2CPP'))">
    <_ManagedRefPath Condition="'$(ManagedRefPath)' != ''">$(ManagedRefPath)</_ManagedRefPath>
    <_ManagedRefPath Condition="'$(_ManagedRefPath)' == ''">$(GamePath)/$(GameData)/Managed</_ManagedRefPath>
  </PropertyGroup>
  <ItemGroup Condition="!$(Configuration.Contains('IL2CPP'))">
    <Reference Include="UnityEngine"><HintPath>$(_ManagedRefPath)/UnityEngine.dll</HintPath></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(_ManagedRefPath)/UnityEngine.CoreModule.dll</HintPath></Reference>
    <Reference Include="UnityEngine.IMGUIModule"><HintPath>$(_ManagedRefPath)/UnityEngine.IMGUIModule.dll</HintPath></Reference>
    <Reference Include="UnityEngine.InputLegacyModule"><HintPath>$(_ManagedRefPath)/UnityEngine.InputLegacyModule.dll</HintPath></Reference>
    <Reference Include="UnityEngine.UIModule"><HintPath>$(_ManagedRefPath)/UnityEngine.UIModule.dll</HintPath></Reference>
    <Reference Include="UnityEngine.UI"><HintPath>$(_ManagedRefPath)/UnityEngine.UI.dll</HintPath></Reference>
    <Reference Include="UnityEngine.TextRenderingModule"><HintPath>$(_ManagedRefPath)/UnityEngine.TextRenderingModule.dll</HintPath></Reference>
    <Reference Include="UnityEngine.ImageConversionModule"><HintPath>$(_ManagedRefPath)/UnityEngine.ImageConversionModule.dll</HintPath></Reference>
    <Reference Include="Unity.TextMeshPro"><HintPath>$(_ManagedRefPath)/Unity.TextMeshPro.dll</HintPath></Reference>
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="System.Memory" Version="4.5.5" />
    <PackageReference Include="System.Numerics.Vectors" Version="4.5.0" />
  </ItemGroup>

  <ItemGroup Condition="$(Configuration.Contains('IL2CPP'))">
    <Reference Include="Il2Cppmscorlib"><HintPath>$(Il2CppData)/Il2Cppmscorlib.dll</HintPath></Reference>
    <Reference Include="UnityEngine"><HintPath>$(Il2CppData)/UnityEngine.dll</HintPath></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(Il2CppData)/UnityEngine.CoreModule.dll</HintPath></Reference>
    <Reference Include="UnityEngine.IMGUIModule"><HintPath>$(Il2CppData)/UnityEngine.IMGUIModule.dll</HintPath></Reference>
    <Reference Include="UnityEngine.InputLegacyModule"><HintPath>$(Il2CppData)/UnityEngine.InputLegacyModule.dll</HintPath></Reference>
    <Reference Include="UnityEngine.UIModule"><HintPath>$(Il2CppData)/UnityEngine.UIModule.dll</HintPath></Reference>
    <Reference Include="UnityEngine.UI"><HintPath>$(Il2CppData)/UnityEngine.UI.dll</HintPath></Reference>
    <Reference Include="UnityEngine.TextRenderingModule"><HintPath>$(Il2CppData)/UnityEngine.TextRenderingModule.dll</HintPath></Reference>
    <Reference Include="UnityEngine.TextCoreFontEngineModule"><HintPath>$(Il2CppData)/UnityEngine.TextCoreFontEngineModule.dll</HintPath></Reference>
    <Reference Include="UnityEngine.ImageConversionModule"><HintPath>$(Il2CppData)/UnityEngine.ImageConversionModule.dll</HintPath></Reference>
    <!-- TMPro proxy: MelonLoader's generator ships it as Unity.TextMeshPro.dll
         with the Il2CppTMPro namespace (see the global TMPro alias below). -->
    <Reference Include="Unity.TextMeshPro"><HintPath>$(Il2CppData)/Unity.TextMeshPro.dll</HintPath></Reference>
    <Reference Include="Unity.Burst" Condition="Exists('$(Il2CppData)/Unity.Burst.dll')"><HintPath>$(Il2CppData)/Unity.Burst.dll</HintPath></Reference>
    <Reference Include="Unity.Collections" Condition="Exists('$(Il2CppData)/Unity.Collections.dll')"><HintPath>$(Il2CppData)/Unity.Collections.dll</HintPath></Reference>
    <Reference Include="Unity.Mathematics" Condition="Exists('$(Il2CppData)/Unity.Mathematics.dll')"><HintPath>$(Il2CppData)/Unity.Mathematics.dll</HintPath></Reference>
    <!-- IL2CPP loader interop (MelonLoader-based games). Same layout as Overlayer. -->
    <Reference Include="Il2CppInterop.Runtime"><HintPath>$(_Il2CppLoaderPath)/MelonLoader/net6/Il2CppInterop.Runtime.dll</HintPath></Reference>
    <Reference Include="MelonLoader"><HintPath>$(_Il2CppLoaderPath)/MelonLoader/net6/MelonLoader.dll</HintPath></Reference>
  </ItemGroup>


  <!-- LitMotion v2 (MIT): compiled for IL2CPP where Burst/Collections are available. -->
  <ItemGroup Condition="$(Configuration.Contains('IL2CPP'))">
    <Using Include="Il2CppTMPro" Alias="TMPro" />
  </ItemGroup>
  <ItemGroup Condition="$(Configuration.Contains('IL2CPP'))">
    <!-- LitMotion sources are opt-in via the LITMOTION define (needs Burst/Collections in metadata).
         Excluded by default for maximum game compatibility; AutoTweenRunner uses the GTween backend instead.
    <Compile Include="../../lib/LitMotion/src/LitMotion/Assets/LitMotion/Runtime/**/*.cs"
             Exclude="../../lib/LitMotion/src/LitMotion/Assets/LitMotion/Runtime/External/**/*.cs;../../lib/LitMotion/src/LitMotion/Assets/LitMotion/Runtime/Extensions/**/*.cs" />
    <Compile Include="../../lib/LitMotion/src/LitMotion/Assets/LitMotion/Runtime/Extensions/uGUI/**/*.cs" /> -->
  </ItemGroup>

  <Target Name="CheckLitMotion" BeforeTargets="BeforeBuild" Condition="$(DefineConstants.Contains('LITMOTION'))">
    <Error Condition="!Exists('../../lib/LitMotion/src/LitMotion/Assets/LitMotion/Runtime/LMotion.Create.cs')"
           Text="LitMotion submodule is missing. Run: git submodule update --init --depth 1" />
  </Target>

  <!-- Bundled modlist-org artwork + OFL fonts (see Asset/NOTICE.md). -->
  <ItemGroup>
    <EmbeddedResource Include="Asset\**\*.png" />
    <EmbeddedResource Include="Asset\**\*.otf" />
    <EmbeddedResource Include="Asset\**\*.ttf" />
    <!-- Superseded O5Kit-original shapes (kept on disk only, unreferenced). -->
    <EmbeddedResource Remove="Asset\Image\Panel256.png;Asset\Image\Control256.png;Asset\Image\TopBar256.png;Asset\Image\Outline256.png;Asset\Image\Ring256.png" />
  </ItemGroup>

  <PropertyGroup>
    <_IconFontGenDir>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/../../tool/IconFontGen'))</_IconFontGenDir>
    <_IconFontGenProj>$(_IconFontGenDir)/IconFontGen.csproj</_IconFontGenProj>
    <_IconFontGenDll>$(_IconFontGenDir)/bin/Release/net10.0/IconFontGen.dll</_IconFontGenDll>
    <_IconFontManifest>$(MSBuildProjectDirectory)/Asset/Icons/icons.json</_IconFontManifest>
  </PropertyGroup>

  <ItemGroup>
    <_IconFontGenSource Include="$(_IconFontGenProj);$(_IconFontGenDir)/*.cs" />
    <_IconFontInputs Include="$(_IconFontManifest);Asset/Icons/*.svg;$(_IconFontGenDll)" />
  </ItemGroup>

  <Target Name="BuildIconFontGen"
          BeforeTargets="DispatchToInnerBuilds"
          Inputs="@(_IconFontGenSource)"
          Outputs="$(_IconFontGenDll)">
    <Exec Command="dotnet build &quot;$(_IconFontGenProj)&quot; -c Release --nologo -v q" />
  </Target>

  <Target Name="GenerateIconFont"
          DependsOnTargets="BuildIconFontGen"
          Condition="'$(TargetFramework)' != ''"
          Inputs="@(_IconFontInputs)"
          Outputs="$(IntermediateOutputPath)Icons/O5KitIcons.ttf">
    <Exec Command="dotnet &quot;$(_IconFontGenDll)&quot; &quot;$(_IconFontManifest)&quot; &quot;$(IntermediateOutputPath)Icons/O5KitIcons.ttf&quot;" />
  </Target>

  <Target Name="IncludeIconFont"
          DependsOnTargets="GenerateIconFont"
          Condition="'$(TargetFramework)' != ''"
          BeforeTargets="AssignTargetPaths;PrepareResources;PrepareResourceNames">
    <ItemGroup>
      <EmbeddedResource Include="$(IntermediateOutputPath)Icons/O5KitIcons.ttf" LogicalName="O5Kit.Asset.Font.O5KitIcons.ttf" />
    </ItemGroup>
  </Target>
</Project>
