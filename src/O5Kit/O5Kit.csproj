<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Dual-target like Overlayer: netstandard2.1 = Mono, net6.0 = IL2CPP -->
    <TargetFrameworks>netstandard2.1;net6.0</TargetFrameworks>
    <PlatformTarget>x64</PlatformTarget>
    <ImplicitUsings>disable</ImplicitUsings>
    <!-- NOTE: ImplicitUsings stays OFF: global `using System;` makes LitMotion's
         Unity.Mathematics.Random ambiguous with System.Random (CS0104). -->
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>O5Kit</RootNamespace>
    <AssemblyName>O5Kit</AssemblyName>
    <Version>0.1.0</Version>
    <Authors>modlist-org</Authors>
    <Description>O5 UI toolkit for Unity mods: pretty uGUI controls + input (UniverseLib-style). LGPL-3.0-or-later.</Description>
    <PackageLicenseExpression>LGPL-3.0-or-later</PackageLicenseExpression>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
    <IsPackable>true</IsPackable>
    <Configurations>Debug_Mono;Release_Mono;Debug_IL2CPP;Release_IL2CPP</Configurations>
  </PropertyGroup>

  <ItemDefinitionGroup>
    <!-- Game/loader assemblies are compile-only (mirrors Overlayer convention). -->
    <Reference>
      <Private>false</Private>
    </Reference>
  </ItemDefinitionGroup>

  <PropertyGroup Condition="$(Configuration.Contains('IL2CPP'))">
    <DefineConstants>$(DefineConstants);IL2CPP</DefineConstants>
  </PropertyGroup>

  <!--
    Unity assemblies come from the game install (same pattern as Overlayer).
    Only the small surface used by O5Kit is referenced here; extend as controls are ported.
  -->
  <ItemGroup Condition="!$(Configuration.Contains('IL2CPP'))">
    <Reference Include="UnityEngine"><HintPath>$(GamePath)/$(GameData)/Managed/UnityEngine.dll</HintPath></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(GamePath)/$(GameData)/Managed/UnityEngine.CoreModule.dll</HintPath></Reference>
    <Reference Include="UnityEngine.IMGUIModule"><HintPath>$(GamePath)/$(GameData)/Managed/UnityEngine.IMGUIModule.dll</HintPath></Reference>
    <Reference Include="UnityEngine.InputLegacyModule"><HintPath>$(GamePath)/$(GameData)/Managed/UnityEngine.InputLegacyModule.dll</HintPath></Reference>
    <Reference Include="UnityEngine.UIModule"><HintPath>$(GamePath)/$(GameData)/Managed/UnityEngine.UIModule.dll</HintPath></Reference>
    <Reference Include="UnityEngine.UI"><HintPath>$(GamePath)/$(GameData)/Managed/UnityEngine.UI.dll</HintPath></Reference>
    <Reference Include="UnityEngine.TextRenderingModule"><HintPath>$(GamePath)/$(GameData)/Managed/UnityEngine.TextRenderingModule.dll</HintPath></Reference>
    <Reference Include="UnityEngine.ImageConversionModule"><HintPath>$(GamePath)/$(GameData)/Managed/UnityEngine.ImageConversionModule.dll</HintPath></Reference>
    <Reference Include="Unity.TextMeshPro"><HintPath>$(GamePath)/$(GameData)/Managed/Unity.TextMeshPro.dll</HintPath></Reference>
    <Reference Include="Unity.Burst"><HintPath>$(GamePath)/$(GameData)/Managed/Unity.Burst.dll</HintPath></Reference>
    <Reference Include="Unity.Collections"><HintPath>$(GamePath)/$(GameData)/Managed/Unity.Collections.dll</HintPath></Reference>
    <Reference Include="Unity.Mathematics"><HintPath>$(GamePath)/$(GameData)/Managed/Unity.Mathematics.dll</HintPath></Reference>
  </ItemGroup>

  <ItemGroup Condition="$(Configuration.Contains('IL2CPP'))">
    <Reference Include="UnityEngine"><HintPath>$(Il2CppData)/UnityEngine.dll</HintPath></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(Il2CppData)/UnityEngine.CoreModule.dll</HintPath></Reference>
    <Reference Include="UnityEngine.IMGUIModule"><HintPath>$(Il2CppData)/UnityEngine.IMGUIModule.dll</HintPath></Reference>
    <Reference Include="UnityEngine.InputLegacyModule"><HintPath>$(Il2CppData)/UnityEngine.InputLegacyModule.dll</HintPath></Reference>
    <Reference Include="UnityEngine.UIModule"><HintPath>$(Il2CppData)/UnityEngine.UIModule.dll</HintPath></Reference>
    <Reference Include="UnityEngine.UI"><HintPath>$(Il2CppData)/UnityEngine.UI.dll</HintPath></Reference>
    <Reference Include="UnityEngine.TextRenderingModule"><HintPath>$(Il2CppData)/UnityEngine.TextRenderingModule.dll</HintPath></Reference>
    <Reference Include="UnityEngine.ImageConversionModule"><HintPath>$(Il2CppData)/UnityEngine.ImageConversionModule.dll</HintPath></Reference>
    <Reference Include="Unity.TextMeshPro"><HintPath>$(Il2CppData)/Unity.TextMeshPro.dll</HintPath></Reference>
    <Reference Include="Unity.Burst"><HintPath>$(Il2CppData)/Unity.Burst.dll</HintPath></Reference>
    <Reference Include="Unity.Collections"><HintPath>$(Il2CppData)/Unity.Collections.dll</HintPath></Reference>
    <Reference Include="Unity.Mathematics"><HintPath>$(Il2CppData)/Unity.Mathematics.dll</HintPath></Reference>
    <!-- IL2CPP loader interop (MelonLoader-based games). Same layout as Overlayer. -->
    <Reference Include="Il2CppInterop.Runtime"><HintPath>$(GamePath)/MelonLoader/net6/Il2CppInterop.Runtime.dll</HintPath></Reference>
    <Reference Include="MelonLoader"><HintPath>$(GamePath)/MelonLoader/net6/MelonLoader.dll</HintPath></Reference>
  </ItemGroup>

  <ItemGroup>
    <!-- NCalc: math expression evaluation for numeric input fields (O5Kit.Math). MIT. -->
    <PackageReference Include="ncalc" Version="7.0.2" />
  </ItemGroup>

  <!-- LitMotion v2 (MIT): compiled from submodule source (Runtime only).
       External/* (UniTask/UniRx/R3 bridges) and Extensions/* (separate asmdefs,
       opt-in later) are excluded. -->
  <ItemGroup>
    <Compile Include="../../lib/LitMotion/src/LitMotion/Assets/LitMotion/Runtime/**/*.cs"
             Exclude="../../lib/LitMotion/src/LitMotion/Assets/LitMotion/Runtime/External/**/*.cs;../../lib/LitMotion/src/LitMotion/Assets/LitMotion/Runtime/Extensions/**/*.cs" />
  </ItemGroup>

  <Target Name="CheckLitMotion" BeforeTargets="BeforeBuild">
    <Error Condition="!Exists('../../lib/LitMotion/src/LitMotion/Assets/LitMotion/Runtime/LMotion.Create.cs')"
           Text="LitMotion submodule is missing. Run: git submodule update --init --depth 1" />
  </Target>

  <!-- Bundled CC BY 4.0 artwork + OFL fonts (see Asset/NOTICE.md). -->
  <ItemGroup>
    <EmbeddedResource Include="Asset\**\*.png" />
    <EmbeddedResource Include="Asset\**\*.otf" />
    <EmbeddedResource Include="Asset\**\*.ttf" />
  </ItemGroup>
</Project>
