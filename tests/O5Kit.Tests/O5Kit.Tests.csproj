<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>O5Kit.Tests</RootNamespace>
    <AssemblyName>O5Kit.Tests</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\O5Kit\O5Kit.csproj" />
    <!-- Type-layout only: lets tests touch options holding UnityEngine value
         types (Color/Sprite) without the Unity runtime. No engine methods
         are ever called. -->
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(GamePath)/$(GameData)/Managed/UnityEngine.CoreModule.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

</Project>
